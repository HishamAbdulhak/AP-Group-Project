<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="768.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="groupproject.apgroupproject.controllers.AdminController">
   
   <!-- SIDEBAR -->
   <left>
      <VBox prefHeight="768.0" prefWidth="192.0" style="-fx-background-color: #2C3E50;" BorderPane.alignment="CENTER">
         <children>
            <Label text="UniHelp AI" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="30.0" left="20.0" top="30.0" />
               </VBox.margin>
            </Label>
            
            <Button fx:id="homeButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="46.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="Home">
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" />
               </VBox.margin>
               <padding>
                  <Insets left="20.0" />
               </padding>
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            
            <Button fx:id="aiChatButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="46.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="AI Chat">
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" />
               </VBox.margin>
               <padding>
                  <Insets left="20.0" />
               </padding>
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            
            <Button fx:id="browseButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="46.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="Browse Topics">
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" />
               </VBox.margin>
               <padding>
                  <Insets left="20.0" />
               </padding>
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            
            <!-- Admin Button (ACTIVE) -->
            <Button fx:id="adminDashboard" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="46.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-border-color: white; -fx-border-radius: 7; -fx-border-width: 1;" text="Admin Dashboard">
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" />
               </VBox.margin>
               <padding>
                  <Insets left="20.0" />
               </padding>
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Button>
            
            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="myProfileButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="46.0" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="My Profile">
               <padding>
                  <Insets left="20.0" />
               </padding>
               <font>
                  <Font size="13.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="20.0" left="10.0" right="10.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </left>
   
   <!-- MAIN DASHBOARD CONTENT -->
   <center>
      <VBox spacing="30.0" style="-fx-background-color: #Fdfdfd;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </padding>
         <children>
            
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <VBox>
                     <children>
                        <Label text="Knowledge Base Manager">
                           <font>
                              <Font name="System Bold" size="28.0" />
                           </font>
                        </Label>
                        <Label text="Manage documents and monitor ingestion status." textFill="#7f8c8d" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="adminSettings" mnemonicParsing="false" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-cursor: hand;" text="⚙ Settings">
                     <padding>
                        <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                     </padding>
                  </Button>
               </children>
            </HBox>
            
            <!-- Stats Cards -->
            <HBox spacing="20.0">
               <children>
                  <!-- Card 1 -->
                  <VBox spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0); -fx-padding: 20;">
                     <children>
                        <Label text="Total Documents" textFill="#7f8c8d" />
                        <Label fx:id="totalDocuments" text="0">
                           <font>
                              <Font name="System Bold" size="24.0" />
                           </font>
                        </Label>
                     </children>
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                     <prefWidth>200.0</prefWidth>
                  </VBox>
                  <!-- Card 2 -->
                  <VBox spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0); -fx-padding: 20;">
                     <children>
                        <Label text="Pending Ingestion" textFill="#7f8c8d" />
                        <Label text="0" textFill="#27ae60">
                           <font>
                              <Font name="System Bold" size="24.0" />
                           </font>
                        </Label>
                     </children>
                     <prefWidth>200.0</prefWidth>
                  </VBox>
                  <!-- Card 3 -->
                  <VBox spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0); -fx-padding: 20;">
                     <children>
                        <Label text="Last Update" textFill="#7f8c8d" />
                        <Label fx:id="lastUpdateTime" text="0 mins ago">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                           <padding>
                              <Insets top="5.0" />
                           </padding>
                        </Label>
                     </children>
                     <prefWidth>200.0</prefWidth>
                  </VBox>
               </children>
            </HBox>
            
            <!-- Document Table -->
            <VBox spacing="10.0" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Existing Files">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  
                  <TableView fx:id="filesTable" style="-fx-background-color: white; -fx-border-color: #ecf0f1;" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="fileNameCol" prefWidth="300.0" text="File Name" />
                      <TableColumn fx:id="fileDateCol" prefWidth="150.0" text="Date Uploaded" />
                        <TableColumn fx:id="fileStatusCol" prefWidth="120.0" text="Status" />
                        <TableColumn fx:id="fileActionsCol" prefWidth="100.0" text="Actions" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
            
            <!-- Upload Zone -->
            <VBox fx:id="dropZone" alignment="CENTER" prefHeight="150.0" spacing="10.0" style="-fx-background-color: #F0F8FF; -fx-border-color: #3498db; -fx-border-width: 2; -fx-border-style: dashed; -fx-background-radius: 10; -fx-border-radius: 10; -fx-cursor: hand;">
               <children>
                  <Label text="Drag &amp; Drop new files here (PDF, DOCX, TXT)" textFill="#34495e">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <Label text="or" textFill="#7f8c8d" />
                  <Button fx:id="uploadButton" mnemonicParsing="false" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Choose File">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                     <padding>
                        <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
                     </padding>
                  </Button>
               </children>
            </VBox>
            
         </children>
      </VBox>
   </center>
</BorderPane>
